# ---------------------------------------------------------------------------
# CryptoPay Gateway - environment template (testnet only)
# Copy to .env and fill in real testnet values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database / queue -------------------------------------------------------
DATABASE_URL=postgresql://cryptopay:cryptopay@localhost:5432/cryptopay?schema=public
REDIS_URL=redis://localhost:6379

# --- Web app ----------------------------------------------------------------
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Chain (Base Sepolia primary) ------------------------------------------
CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_ID=84532
RPC_URL_PRIMARY=https://sepolia.base.org
RPC_URL_FALLBACK=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Deployed contract addresses (filled by the Phase 1 deploy script)
PAYMENT_PROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PAYMENT_PROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000
TEST_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TEST_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Indexer ----------------------------------------------------------------
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_BLOCK_RANGE=1000
INDEXER_CONFIRMATIONS=5
# INDEXER_START_BLOCK=0
HEALTH_PORT=9464

# --- Worker / webhooks ------------------------------------------------------
WEBHOOK_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WEBHOOK_MAX_ATTEMPTS=6
WORKER_CONCURRENCY=10
WORKER_HEALTH_PORT=9465

# --- Platform ---------------------------------------------------------------
PLATFORM_FEE_BPS=100
# Comma-separated lowercase wallet addresses allowed into the admin console.
ADMIN_WALLETS=
LOG_LEVEL=info

# --- Test-only helpers ------------------------------------------------------
# Local Anvil account #0 (never use on mainnet)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
